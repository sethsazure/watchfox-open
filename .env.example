# Copy to .env (or ~/.watchfox/.env). Everything is optional.

# Gmail sign-in (Docs → Sources → Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 sign-in (Docs → Sources → Microsoft 365)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# So nothing has to be typed in the console
# WATCHFOX_IMAP_HOST=imap.example.com
# WATCHFOX_IMAP_USER=me@example.com
# WATCHFOX_IMAP_PASSWORD=app-password
# WATCHFOX_FTP_URL=ftp://user:password@ftp.example.com/incoming

# Protect the API (required if you listen on 0.0.0.0)
# WATCHFOX_API_KEY=change-me
# WATCHFOX_HOST=127.0.0.1
# WATCHFOX_PORT=8787

# Optional: AI assistant that drafts question wordings and sample emails in the "Create a type" wizard.
# It only sees the description typed into the wizard. Without it the wizard still works from your own examples.
# AZURE_AI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_AI_KEY=
# AZURE_AI_DEPLOYMENT=tuning
# Or, instead of Azure, OpenAI directly:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# WATCHFOX_TUNING_MODEL=gpt-4o-mini

# Sign in with GitHub / Google / Microsoft (callback: <WATCHFOX_URL>/auth/login/<github|google|microsoft>/callback)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# (Google and Microsoft reuse GOOGLE_CLIENT_ID/SECRET and MS_CLIENT_ID/SECRET above)

# Outgoing email for verification, password reset and invitations. Without it, links are shown on screen on a local install.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=WatchFox <no-reply@yourdomain.com>

# The Laya model server (laya-serve), for example a GPU box on your Tailscale network. Required.
# LAYA_URL=https://your-host.your-tailnet.ts.net:9443
# LAYA_API_KEY=
# LAYA_TIMEOUT=30

# Optional backup for the Laya model when the main server is down: the same model via Vercel AI Gateway.
# Email text is sent to Vercel while it is in use. Needs a card on file at Vercel to unlock the (free) credits.
# LAYA_FALLBACK_KEY=
# LAYA_FALLBACK_MODEL=convaiinnovations/laya

# Local development without sign-in providers: allow email-and-password accounts (production uses GitHub, Google and Microsoft only)
# WATCHFOX_PASSWORD_LOGIN=1

# Send invitation emails through Cloudflare Email Service (REST). Onboard the domain under Email Sending, then create an API token with "Email Sending: Edit".
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_TOKEN=
# EMAIL_FROM_ADDRESS=notifications@watchfox.run

# Helcim payments. Create the token under Helcim > All Tools > Integrations > API Access Configurations, listing your domain for HelcimPay.js.
# HELCIM_API_TOKEN=
# Try the flow cheaply: for these owner emails, subscriptions are created at HELCIM_TEST_AMOUNT instead of the real price.
# HELCIM_TEST_EMAILS=you@example.com
# HELCIM_TEST_AMOUNT=1.00
